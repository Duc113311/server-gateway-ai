# ═══════════════════════════════════════════════════════════════════════════
#  1. CHAT — which upstream answers /v1/chat
# ═══════════════════════════════════════════════════════════════════════════
# openai | gemini | deepseek | grok | compat
# Switching is an env change + redeploy; the app sees no difference. Only the
# key for the selected provider is required — the server refuses to boot
# without it. NEVER commit the real values.
AI_PROVIDER=openai

# ── OpenAI ────────── https://platform.openai.com/api-keys  (key: sk-...)
# Models: gpt-5, gpt-5-mini, gpt-5-nano, gpt-4.1, gpt-4.1-mini, gpt-4o-mini
# The gpt-5 / o-series line is reasoning: it takes reasoning_effort=low and
# rejects temperature — the provider handles that for you.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Override only to point at a proxy, Azure, or a local stub.
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Google Gemini ── https://aistudio.google.com/apikey  (key: AIza...)
# Models: gemini-2.5-pro, gemini-2.5-flash, gemini-2.5-flash-lite,
#         gemini-2.0-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ── DeepSeek ──────── https://platform.deepseek.com/api_keys  (key: sk-...)
# Models: deepseek-chat (fast, cheapest here), deepseek-reasoner (thinks first;
# it is the one model that cannot be held to JSON mode, so the chat card falls
# back to prompt-only formatting — prefer deepseek-chat for this app).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── xAI Grok ──────── https://console.x.ai  (key: xai-...)
# Models: grok-4, grok-4-fast (best price/latency), grok-3, grok-3-mini
GROK_API_KEY=
GROK_MODEL=grok-4-fast
GROK_BASE_URL=https://api.x.ai/v1

# ── Anything else OpenAI-compatible (AI_PROVIDER=compat) ──
# Addressed by URL instead of by name. This is where the free tiers live:
#
#   OpenRouter     https://openrouter.ai/api/v1
#                  model: deepseek/deepseek-chat-v3-0324:free (the `:free`
#                  suffix marks the no-cost pool; daily cap, shared capacity)
#   GitHub Models  https://models.github.ai/inference
#                  model: openai/gpt-4o-mini — free with a GitHub account and
#                  a PAT, on a low per-minute/per-day allowance
#   Groq           https://api.groq.com/openai/v1
#                  model: llama-3.3-70b-versatile — free tier, very fast
#   Ollama (local) http://localhost:11434/v1   model: llama3.2  (no key)
#
# COMPAT_API_KEY may be left empty for a keyless endpoint; BASE_URL and MODEL
# are required. Leave TOKEN_PARAM alone unless the endpoint rejects max_tokens.
COMPAT_API_KEY=
COMPAT_MODEL=
COMPAT_BASE_URL=
# max_tokens | max_completion_tokens
COMPAT_TOKEN_PARAM=max_tokens

# ═══════════════════════════════════════════════════════════════════════════
#  2. IMAGE — /v1/image     (off = the route answers 404 feature_disabled)
# ═══════════════════════════════════════════════════════════════════════════
# off | openai | gemini | grok      — reuses the key from section 1.
IMAGE_PROVIDER=off

# gpt-image-1 (best quality, always returns base64) | dall-e-3 (cheaper, n=1)
OPENAI_IMAGE_MODEL=gpt-image-1
# gemini-2.5-flash-image ("nano banana", conversational editing, 1 per call)
# | imagen-4.0-generate-001 | imagen-4.0-fast-generate-001 (up to 4 per call)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# grok-2-image-1212 — no size and no quality knob; it picks its own frame.
GROK_IMAGE_MODEL=grok-2-image-1212

# ═══════════════════════════════════════════════════════════════════════════
#  3. VIDEO — /v1/video     (start-then-poll; renders take 1-5 minutes)
# ═══════════════════════════════════════════════════════════════════════════
# off | gemini (Veo) | openai (Sora)      — reuses the key from section 1.
# This is the most expensive call in the gateway by an order of magnitude;
# leave it off unless VIDEO_RATE_PER_DAY is set to something you can afford.
VIDEO_PROVIDER=off

# veo-3.0-fast-generate-001 (cheapest, 8s fixed, with audio)
# | veo-3.0-generate-001 | veo-2.0-generate-001 (5-8s, takes durationSeconds)
GEMINI_VIDEO_MODEL=veo-3.0-fast-generate-001
# sora-2 | sora-2-pro — sizes 720x1280 / 1280x720, length 4, 8 or 12 seconds.
OPENAI_VIDEO_MODEL=sora-2

# ═══════════════════════════════════════════════════════════════════════════
#  4. TRANSLATE — /v1/translate
# ═══════════════════════════════════════════════════════════════════════════
# off | model | google
#   model  = translate through AI_PROVIDER above. No extra key, keeps tone and
#            context, understands placeholders — billed as chat tokens.
#   google = Cloud Translation v2. Billed per character (far cheaper in bulk),
#            100+ languages, but literal: no tone, no context.
TRANSLATE_PROVIDER=off

# Only for TRANSLATE_PROVIDER=google. An API key restricted to the Cloud
# Translation API (console.cloud.google.com > APIs & Services > Credentials),
# NOT a service account and NOT the Gemini key.
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_BASE_URL=https://translation.googleapis.com/language/translate/v2

# ═══════════════════════════════════════════════════════════════════════════
#  5. AUTH
# ═══════════════════════════════════════════════════════════════════════════
# firebase = every call must carry a valid Firebase ID token (anonymous
# sign-in counts). none = no auth, LOCAL DEVELOPMENT ONLY — an open gateway
# spends your tokens for anyone who finds the URL.
AUTH_MODE=firebase

# Only read when AUTH_MODE=firebase. Two ways to authenticate:
#
#   a path  — the smartdrink-ai service account JSON (Firebase console >
#             Project settings > Service accounts). For running outside
#             Google's infrastructure, and for local work against the real
#             project.
#   empty   — Application Default Credentials. On Cloud Run / Functions / GCE
#             in the smartdrink-ai project the runtime service account comes
#             from the metadata server, so there is NO key file to ship, mount
#             or leak. Set it empty in a deployment.
SERVICE_ACCOUNT_PATH=./serviceAccount.json

# ═══════════════════════════════════════════════════════════════════════════
#  6. COST GUARDS — every quota is per Firebase uid, per feature, per day
# ═══════════════════════════════════════════════════════════════════════════
# One anonymous uid per device install, so these are the daily free allowance
# each device gets. Features do not share a bucket: an image never eats the
# chat allowance.

# ── Chat ──
# Longest single message a client may send.
MAX_PROMPT_CHARS=1000
# How many past turns are replayed to the model. Every turn is re-billed as
# input on every call, so this is the main lever on cost per message.
MAX_HISTORY_TURNS=12
# Ceiling on the reply length.
MAX_OUTPUT_TOKENS=500
RATE_PER_MINUTE=8
RATE_PER_DAY=5
# Give up on the provider after this long.
UPSTREAM_TIMEOUT_MS=30000

# ── Image ──
MAX_IMAGE_PROMPT_CHARS=1000
# Hard ceiling on `n`, whatever the client asks for.
MAX_IMAGES_PER_REQUEST=1
IMAGE_RATE_PER_MINUTE=2
IMAGE_RATE_PER_DAY=5
# Image models are slow; this timeout is separate from the chat one.
IMAGE_TIMEOUT_MS=120000

# ── Video ──
MAX_VIDEO_PROMPT_CHARS=1000
VIDEO_RATE_PER_DAY=2
# How long a finished job stays downloadable through /v1/video/:id/content.
VIDEO_JOB_TTL_MS=3600000

# ── Translate ──
# Per call, across the whole batch.
MAX_TRANSLATE_CHARS=5000
MAX_TRANSLATE_ITEMS=50
TRANSLATE_RATE_PER_MINUTE=20
TRANSLATE_RATE_PER_DAY=200

# ═══════════════════════════════════════════════════════════════════════════
#  7. SERVER
# ═══════════════════════════════════════════════════════════════════════════
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info
