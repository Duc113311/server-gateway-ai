# ── Which upstream to bill ───────────────────────────────────────────────────
# openai | gemini. Switching is an env change + redeploy; the app sees no
# difference.
AI_PROVIDER=openai

# Only the key for the selected provider is required; the server refuses to
# boot without it. NEVER commit the real values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Auth ─────────────────────────────────────────────────────────────────────
# firebase = every call must carry a valid Firebase ID token (anonymous
# sign-in counts). none = no auth, LOCAL DEVELOPMENT ONLY — an open gateway
# spends your tokens for anyone who finds the URL.
AUTH_MODE=firebase

# Path to the smartdrink-ai service account JSON (Firebase console > Project
# settings > Service accounts). Only read when AUTH_MODE=firebase.
SERVICE_ACCOUNT_PATH=./serviceAccount.json

# ── Cost guards ──────────────────────────────────────────────────────────────
# Longest single message a client may send.
MAX_PROMPT_CHARS=1000
# How many past turns are replayed to the model. Every turn is re-billed as
# input on every call, so this is the main lever on cost per message.
MAX_HISTORY_TURNS=12
# Ceiling on the reply length.
MAX_OUTPUT_TOKENS=500
# Per-user quota, counted against the Firebase uid.
RATE_PER_MINUTE=8
RATE_PER_DAY=60
# Give up on the provider after this long.
UPSTREAM_TIMEOUT_MS=30000

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info
